package	harfbuzz_aat

import 	"core:c"
//import cm "./common"
import hrfb		".."
import hb_ot	"../ot"

when ODIN_OS == .Windows	{	foreign import hb_aat "../windows/harfbuzz.lib"	}
else when ODIN_OS == .Linux	{	foreign import hb_aat "system:harfbuzz"	}

/*******************
hb-aat-layout — Apple Advanced Typography Layout

Functions for querying AAT Layout features in the font face.

HarfBuzz supports all of the AAT tables used to implement shaping. Other AAT tables and their associated features are not supported.
*******************/

//******************
// TYPES
//******************

/*
#define HB_AAT_LAYOUT_NO_SELECTOR_INDEX		0xFFFFu

Used when getting or setting AAT feature selectors. Indicates that there is no selector index corresponding to the
selector of interest.
*/
LAYOUT_NO_SELECTOR_INDEX	: c.int	:	0xFFFF

/*
enum hb_aat_layout_feature_type_t

The possible feature types defined for AAT shaping, from Apple Font Feature Registry.

Since: 2.2.0
*/
layout_feature_type_t :: enum (i32)
{
	LAYOUT_FEATURE_TYPE_INVALID								=  0,	// Initial, unset feature type
	LAYOUT_FEATURE_TYPE_ALL_TYPOGRAPHIC						=  1,	// All Typographic Features
	LAYOUT_FEATURE_TYPE_LIGATURES							=  2,	// Ligatures
	LAYOUT_FEATURE_TYPE_CURSIVE_CONNECTION					=  3,	// Cursive Connection
	LAYOUT_FEATURE_TYPE_LETTER_CASE							=  4,	// Letter Case
	LAYOUT_FEATURE_TYPE_VERTICAL_SUBSTITUTION				=  5,	// Vertical Substitution
	LAYOUT_FEATURE_TYPE_LINGUISTIC_REARRANGEMENT			=  6,	// Linguistic Rearrangement
	// item 7 undefined
	LAYOUT_FEATURE_TYPE_NUMBER_SPACING						=  8,	// Number Spacing
	LAYOUT_FEATURE_TYPE_SMART_SWASH_TYPE					=  9,	// Smart Swash
	LAYOUT_FEATURE_TYPE_DIACRITICS_TYPE						= 10,	// Diacritics
	LAYOUT_FEATURE_TYPE_VERTICAL_POSITION					= 11,	// Vertical Position
	// item 12 undefined
	LAYOUT_FEATURE_TYPE_FRACTIONS							= 13,	// Fractions
	LAYOUT_FEATURE_TYPE_OVERLAPPING_CHARACTERS_TYPE			= 14,	// Overlapping Characters
	LAYOUT_FEATURE_TYPE_TYPOGRAPHIC_EXTRAS					= 15,	// Typographic Extras
	LAYOUT_FEATURE_TYPE_MATHEMATICAL_EXTRAS					= 16,	// Mathematical Extras
	LAYOUT_FEATURE_TYPE_ORNAMENT_SETS_TYPE					= 17,	// Ornament Sets
	LAYOUT_FEATURE_TYPE_CHARACTER_ALTERNATIVES				= 18,	// Character Alternatives
	LAYOUT_FEATURE_TYPE_DESIGN_COMPLEXITY_TYPE				= 19,	// Design Complexity
	LAYOUT_FEATURE_TYPE_STYLE_OPTIONS						= 20,	// Style Options
	LAYOUT_FEATURE_TYPE_CHARACTER_SHAPE						= 21,	// Character Shape
	LAYOUT_FEATURE_TYPE_NUMBER_CASE							= 22,	// Number Case
	LAYOUT_FEATURE_TYPE_TEXT_SPACING						= 23,	// Text Spacing
	LAYOUT_FEATURE_TYPE_TRANSLITERATION						= 24,	// Transliteration
	LAYOUT_FEATURE_TYPE_ANNOTATION_TYPE						= 25,	// Annotation
	LAYOUT_FEATURE_TYPE_KANA_SPACING_TYPE					= 26,	// Kana Spacing
	LAYOUT_FEATURE_TYPE_IDEOGRAPHIC_SPACING_TYPE			= 27,	// Ideographic Spacing
	LAYOUT_FEATURE_TYPE_UNICODE_DECOMPOSITION_TYPE			= 28,	// Unicode Decomposition
	LAYOUT_FEATURE_TYPE_RUBY_KANA							= 29,	// Ruby Kana
	LAYOUT_FEATURE_TYPE_CJK_SYMBOL_ALTERNATIVES_TYPE		= 30,	// CJK Symbol Alternatives
	LAYOUT_FEATURE_TYPE_IDEOGRAPHIC_ALTERNATIVES_TYPE		= 31,	// Ideographic Alternatives
	LAYOUT_FEATURE_TYPE_CJK_VERTICAL_ROMAN_PLACEMENT_TYPE	= 32,	// CJK Vertical Roman Placement
	LAYOUT_FEATURE_TYPE_ITALIC_CJK_ROMAN					= 33,	// Italic CJK Roman
	LAYOUT_FEATURE_TYPE_CASE_SENSITIVE_LAYOUT				= 34,	// Case Sensitive Layout
	LAYOUT_FEATURE_TYPE_ALTERNATE_KANA						= 35,	// Alternate Kana
	LAYOUT_FEATURE_TYPE_STYLISTIC_ALTERNATIVES				= 36,	// Stylistic Alternatives
	LAYOUT_FEATURE_TYPE_CONTEXTUAL_ALTERNATIVES				= 37,	// Contextual Alternatives
	LAYOUT_FEATURE_TYPE_LOWER_CASE							= 38,	// Lower Case
	LAYOUT_FEATURE_TYPE_UPPER_CASE							= 39,	// Upper Case
	LAYOUT_FEATURE_TYPE_LANGUAGE_TAG_TYPE					=103,	// Language Tag
	LAYOUT_FEATURE_TYPE_CJK_ROMAN_SPACING_TYPE				= hrfb.INT_MAX_SIGNED,	// **PRIVATE** CJK Roman Spacing
}
/*
enum hb_aat_layout_feature_selector_t

The selectors defined for specifying AAT feature settings.

Since: 2.2.0
*/
layout_feature_selector_t :: enum (i32)
{
  LAYOUT_FEATURE_SELECTOR_INVALID							= 0xFFFF,

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_ALL_TYPOGRAPHIC */
  LAYOUT_FEATURE_SELECTOR_ALL_TYPE_FEATURES_ON				= 0,
  LAYOUT_FEATURE_SELECTOR_ALL_TYPE_FEATURES_OFF				= 1,

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_LIGATURES */
  LAYOUT_FEATURE_SELECTOR_REQUIRED_LIGATURES_ON				= 0,
  LAYOUT_FEATURE_SELECTOR_REQUIRED_LIGATURES_OFF			= 1,
  LAYOUT_FEATURE_SELECTOR_COMMON_LIGATURES_ON				= 2,
  LAYOUT_FEATURE_SELECTOR_COMMON_LIGATURES_OFF				= 3,
  LAYOUT_FEATURE_SELECTOR_RARE_LIGATURES_ON					= 4,
  LAYOUT_FEATURE_SELECTOR_RARE_LIGATURES_OFF				= 5,
  LAYOUT_FEATURE_SELECTOR_LOGOS_ON							= 6,
  LAYOUT_FEATURE_SELECTOR_LOGOS_OFF							= 7,
  LAYOUT_FEATURE_SELECTOR_REBUS_PICTURES_ON					= 8,
  LAYOUT_FEATURE_SELECTOR_REBUS_PICTURES_OFF				= 9,
  LAYOUT_FEATURE_SELECTOR_DIPHTHONG_LIGATURES_ON			= 10,
  LAYOUT_FEATURE_SELECTOR_DIPHTHONG_LIGATURES_OFF			= 11,
  LAYOUT_FEATURE_SELECTOR_SQUARED_LIGATURES_ON				= 12,
  LAYOUT_FEATURE_SELECTOR_SQUARED_LIGATURES_OFF				= 13,
  LAYOUT_FEATURE_SELECTOR_ABBREV_SQUARED_LIGATURES_ON		= 14,
  LAYOUT_FEATURE_SELECTOR_ABBREV_SQUARED_LIGATURES_OFF		= 15,
  LAYOUT_FEATURE_SELECTOR_SYMBOL_LIGATURES_ON				= 16,
  LAYOUT_FEATURE_SELECTOR_SYMBOL_LIGATURES_OFF				= 17,
  LAYOUT_FEATURE_SELECTOR_CONTEXTUAL_LIGATURES_ON			= 18,
  LAYOUT_FEATURE_SELECTOR_CONTEXTUAL_LIGATURES_OFF			= 19,
  LAYOUT_FEATURE_SELECTOR_HISTORICAL_LIGATURES_ON			= 20,
  LAYOUT_FEATURE_SELECTOR_HISTORICAL_LIGATURES_OFF			= 21,

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_LIGATURES */
  LAYOUT_FEATURE_SELECTOR_UNCONNECTED						= 0,
  LAYOUT_FEATURE_SELECTOR_PARTIALLY_CONNECTED				= 1,
  LAYOUT_FEATURE_SELECTOR_CURSIVE							= 2,

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_LETTER_CASE */
  LAYOUT_FEATURE_SELECTOR_UPPER_AND_LOWER_CASE				= 0, /* deprecated */
  LAYOUT_FEATURE_SELECTOR_ALL_CAPS							= 1, /* deprecated */
  LAYOUT_FEATURE_SELECTOR_ALL_LOWER_CASE					= 2, /* deprecated */
  LAYOUT_FEATURE_SELECTOR_SMALL_CAPS						= 3, /* deprecated */
  LAYOUT_FEATURE_SELECTOR_INITIAL_CAPS						= 4, /* deprecated */
  LAYOUT_FEATURE_SELECTOR_INITIAL_CAPS_AND_SMALL_CAPS		= 5, /* deprecated */

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_VERTICAL_SUBSTITUTION */
  LAYOUT_FEATURE_SELECTOR_SUBSTITUTE_VERTICAL_FORMS_ON		= 0,
  LAYOUT_FEATURE_SELECTOR_SUBSTITUTE_VERTICAL_FORMS_OFF		= 1,

  /* Selectors for HB_AAT_LAYOUT_FEATURE_TYPE_LINGUISTIC_REARRANGEMENT */
