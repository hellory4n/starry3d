/*
typedef struct  hb_aat_layout_feature_selector_info_t;

Structure representing a setting for an hb_aat_layout_feature_type_t.
*/
layout_feature_selector_info_t :: struct #packed
{
  name_id	: hb_ot.name_id_t,				// The selector's name identifier
  enable	: layout_feature_selector_t,	// The value to turn the selector on
  disable	: layout_feature_selector_t		// The value to turn the selector off
}

//******************
// FUNCTIONS
//******************

@(default_calling_convention = "c", link_prefix = "hb_aat_") foreign hb_aat
{

/*
hb_ot_name_id_t hb_aat_layout_feature_type_get_name_id (hb_face_t *face, hb_aat_layout_feature_type_t feature_type);

Fetches the name identifier of the specified feature type in the face's name table.

Input:
- face:			hb_face_t to work upon
- feature_type:	The hb_aat_layout_feature_type_t of the requested feature type
Returns:
- Name identifier of the requested feature type

Since: 2.2.0
*/
layout_feature_type_get_name_id :: proc (face: ^hrfb.face_t, feature_type: layout_feature_type_t)	-> hb_ot.name_id_t	---

/*
unsigned int hb_aat_layout_feature_type_get_selector_infos (hb_face_t *face, hb_aat_layout_feature_type_t feature_type,
	unsigned int start_offset, unsigned int *selector_count, hb_aat_layout_feature_selector_info_t *selectors,
	unsigned int *default_index);

Fetches a list of the selectors available for the specified feature in the given face.

If upon return, default_index is set to HB_AAT_LAYOUT_NO_SELECTOR_INDEX, then the feature type is non-exclusive.
Otherwise, default_index is the index of the selector that is selected by default.

Inputs:
- face:				hb_face_t to work upon
- feature_type:		The hb_aat_layout_feature_type_t of the requested feature type
- start_offset:		offset of the first feature type to retrieve
- selector_count:	Input = the maximum number of selectors to return; Output = the actual number of selectors returned (may be zero). [inout][optional]
- selectors:		A buffer pointer. The selectors available for the feature type queries. [out caller-allocates][array length=selector_count][optional]
- default_index:	The index of the feature's default selector, if any. [out][optional]
Returns:
- Number of all available feature selectors

Since: 2.2.0
*/
layout_feature_type_get_selector_infos :: proc (face: ^hrfb.face_t, feature_type: layout_feature_type_t,
	start_offset: c.uint, selector_count: ^c.uint, selectors: ^layout_feature_selector_info_t,
	default_index: ^c.uint) -> c.uint ---

/*
unsigned int hb_aat_layout_get_feature_types (hb_face_t *face, unsigned int start_offset, unsigned int *feature_count,
	hb_aat_layout_feature_type_t *features);

Fetches a list of the AAT feature types included in the specified face.

Inputs:
- face:				hb_face_t to work upon
- start_offset:		offset of the first feature type to retrieve
- feature_count:	Input = the maximum number of feature types to return; Output = the actual number of feature types returned (may be zero). [inout][optional]
- features:			Array of feature types found. [out caller-allocates][array length=feature_count]
Returns:
- Number of all available feature types.

Since: 2.2.0
*/
layout_get_feature_types :: proc (face: ^hrfb.face_t, start_offset: c.uint, feature_count: ^c.uint,
	features: [^]layout_feature_type_t) -> c.uint ---

/*
hb_bool_t hb_aat_layout_has_positioning (hb_face_t *face);

Tests whether the specified face includes any positioning information in the `kerx` table.

Note: does not examine the `GPOS` table.

Inputs:
- face:	hb_face_t to work upon
Returns:
- true if data found, false otherwise

Since: 2.3.0
*/
layout_has_positioning :: proc (face: ^hrfb.face_t)	-> hrfb.bool_t ---

/*
hb_bool_t hb_aat_layout_has_substitution (hb_face_t *face);

Tests whether the specified face includes any substitutions in the `morx` or `mort` tables.

Note: does not examine the `GSUB` table.

Inputs:
- face:	hb_face_t to work upon
Returns:
- true if data found, false otherwise

Since: 2.3.0
*/
layout_has_substitution :: proc (face: ^hrfb.face_t)	-> hrfb.bool_t ---

/*
hb_bool_t hb_aat_layout_has_tracking (hb_face_t *face);

Tests whether the specified face includes any tracking information in the `trak` table.

Inputs:
- face:	hb_face_t to work upon
Returns:
- true if data found, false otherwise

Since: 2.3.0
*/
layout_has_tracking :: proc (face: ^hrfb.face_t)	-> hrfb.bool_t ---

}
